rules_version = '2';

// Rules updated to sync with new project
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is an admin (signed in via password, not anonymous)
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow anyone to create a document in the 'contacts' collection.
    // This is for the public contact form.
    match /contacts/{contactId} {
      allow create: if true;
      // Allow authenticated admins to read the contact submissions.
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }

    // Public can read blog posts, only admins can write/delete.
    match /blog/{postId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Anyone can create a new chat session and add messages to it
    match /chats/{chatId} {
      // Users can create their own sessions
      allow create: if request.auth != null;
      // Users can read/update their own sessions, admins can read/list all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isAdmin();

       match /messages/{messageId} {
        // Users can create messages in their own chats
        allow create: if request.auth != null;
        // Access is gated by the parent chat's ownership or admin status
        allow read, list: if isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.userId) || isAdmin();
      }
    }
  }
}
