
{
    "entities": {
        "UserProfile": {
            "title": "User Profile",
            "description": "Represents a user's public profile information.",
            "type": "object",
            "properties": {
                "displayName": {
                    "type": "string",
                    "description": "The user's display name."
                },
                "photoURL": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL of the user's profile picture."
                }
            }
        },
        "Contact": {
            "title": "Contact Submission",
            "description": "Represents a message submitted through the contact form.",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The name of the person submitting the form."
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The email address of the person."
                },
                "phone": {
                    "type": "string",
                    "description": "The phone number of the person."
                },
                "message": {
                    "type": "string",
                    "description": "The message content."
                },
                "source": {
                    "type": "string",
                    "description": "The source page where the form was submitted."
                },
                "submittedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the form was submitted."
                }
            },
            "required": [
                "name",
                "email",
                "message",
                "submittedAt"
            ]
        },
        "BlogPost": {
            "title": "Blog Post",
            "description": "Represents a single blog post.",
            "type": "object",
            "properties": {
                "title": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "date": {
                    "type": "string",
                    "format": "date"
                },
                "image": {
                    "type": "string"
                },
                "excerpt": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "keywords": {
                    "type": "string",
                    "description": "Comma-separated SEO keywords."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "title",
                "slug",
                "author",
                "date",
                "image",
                "excerpt",
                "content",
                "language",
                "createdAt"
            ]
        },
        "ChatSession": {
            "title": "Chat Session",
            "description": "Represents a single chat conversation with the AI chatbot.",
            "type": "object",
            "properties": {
                "startedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "lastMessage": {
                    "type": "string"
                },
                "lastMessageAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "userId": {
                    "type": "string",
                    "description": "The ID of the user who initiated the chat, if authenticated."
                },
                "userDisplayName": {
                    "type": "string",
                    "description": "The display name of the user who initiated the chat, if authenticated."
                }
            }
        },
        "ChatMessage": {
            "title": "Chat Message",
            "description": "Represents a single message within a chat session.",
            "type": "object",
            "properties": {
                "sender": {
                    "type": "string",
                    "enum": [
                        "user",
                        "bot"
                    ]
                },
                "text": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    },
    "auth": {
        "providers": [
            "password",
            "anonymous"
        ]
    },
    "firestore": {
        "/users/{userId}": {
            "schema": {
                "$ref": "#/backend/entities/UserProfile"
            },
            "description": "Stores public profile information for each user."
        },
        "/contacts/{contactId}": {
            "schema": {
                "$ref": "#/backend-config/entities/Contact"
            },
            "description": "Stores submissions from the public contact form."
        },
        "/blog/{postId}": {
            "schema": {
                "$ref": "#/backend/entities/BlogPost"
            },
            "description": "Stores all blog posts for the website."
        },
        "/chats/{chatId}": {
            "schema": {
                "$ref": "#/backend-config/entities/ChatSession"
            },
            "description": "Stores all chat sessions with the AI chatbot."
        },
        "/chats/{chatId}/messages/{messageId}": {
            "schema": {
                "$ref": "#/backend-config/entities/ChatMessage"
            },
            "description": "Stores all messages for a given chat session."
        }
    }
}
